<UserControl x:Class="TabSpan.App.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TabSpan.App">
    <UserControl.Resources>
        <Style x:Key="Num" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="12,1,0,1" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,1,16,1" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,12">
            <TextBlock x:Name="NotStreamingText" Text="{local:Str Diag_NotStreaming}" Margin="0,0,0,10"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

            <!-- 遅延の内訳(50% と 95%) -->
            <Grid Margin="0,0,0,12" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="200" />
                    <ColumnDefinition Width="Auto" MinWidth="60" />
                    <ColumnDefinition Width="Auto" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Str Diag_Latency}" FontWeight="SemiBold" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="1" Text="{local:Str Diag_P50}" FontWeight="SemiBold" Style="{StaticResource Num}" />
                <TextBlock Grid.Column="2" Text="{local:Str Diag_P95}" FontWeight="SemiBold" Style="{StaticResource Num}" />

                <TextBlock Grid.Row="1" Text="{local:Str Diag_CaptureToSend}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CaptureP50" Style="{StaticResource Num}" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="CaptureP95" Style="{StaticResource Num}" />

                <TextBlock Grid.Row="2" Text="{local:Str Diag_SendToArrive}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ArriveP50" Style="{StaticResource Num}" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ArriveP95" Style="{StaticResource Num}" />

                <TextBlock Grid.Row="3" Text="{local:Str Diag_ArriveToDecode}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DecodeP50" Style="{StaticResource Num}" />
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="DecodeP95" Style="{StaticResource Num}" />

                <TextBlock Grid.Row="4" Text="{local:Str Diag_Total}" FontWeight="SemiBold" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TotalP50" FontWeight="SemiBold" Style="{StaticResource Num}" />
                <TextBlock Grid.Row="4" Grid.Column="2" x:Name="TotalP95" FontWeight="SemiBold" Style="{StaticResource Num}" />
            </Grid>

            <!-- そのほかの数字(2 列) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Str Diag_Fps}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="1" x:Name="FpsText" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="2" Text="{local:Str Diag_Dropped}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Column="3" x:Name="DroppedText" Style="{StaticResource Cell}" />

                <TextBlock Grid.Row="1" Text="{local:Str Diag_Rtt}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RttText" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{local:Str Diag_Rate}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="RateText" Style="{StaticResource Cell}" />

                <TextBlock Grid.Row="2" Text="{local:Str Diag_Encoder}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EncoderText" Style="{StaticResource Cell}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{local:Str Diag_Size}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="SizeText" Style="{StaticResource Cell}" />

                <TextBlock Grid.Row="3" Text="{local:Str Diag_Touch}" Style="{StaticResource Cell}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TouchText" Style="{StaticResource Cell}" />
            </Grid>

            <!-- 直近 60 秒の合計 -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock x:Name="GraphMaxText" DockPanel.Dock="Right" FontFamily="Consolas"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <TextBlock Text="{local:Str Diag_Graph}" />
            </DockPanel>
            <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Height="90" Margin="0,0,0,12">
                <Canvas x:Name="GraphCanvas" ClipToBounds="True" SizeChanged="OnGraphSizeChanged">
                    <Polyline x:Name="GraphLine" StrokeThickness="1.5" Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </Canvas>
            </Border>

            <Button Content="{local:Str Diag_Copy}" HorizontalAlignment="Left" Padding="12,3" Click="OnCopy" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
