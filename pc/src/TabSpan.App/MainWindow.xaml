<Window x:Class="TabSpan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TabSpan.App"
        Title="{local:Str App_Title}" Width="640" Height="620" MinWidth="520" MinHeight="460"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        PreviewKeyDown="OnPreviewKeyDown">
    <DockPanel>
        <!-- 下の帯: USB と LAN の状態、ポート -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Padding="12,6"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </Border>
        <TabControl x:Name="Tabs" Margin="8,8,8,8">
            <TabItem Header="{local:Str Tab_Main}">
                <DockPanel>
                    <!-- 上の帯: 案内や警告(優先の高い順に 1 つ)。無いときは隠す -->
                    <Border x:Name="Banner" DockPanel.Dock="Top" Padding="12,8" Visibility="Collapsed"
                            Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}">
                        <DockPanel>
                            <Button x:Name="BannerButton" DockPanel.Dock="Right" Padding="12,2" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnBannerButton" />
                            <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
                        </DockPanel>
                    </Border>
                    <Grid Margin="12,12,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{local:Str Main_State}" Margin="0,0,12,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StateText" FontWeight="SemiBold" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Text="{local:Str Main_Device}" Margin="0,0,12,6" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceText" Margin="0,0,0,6" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Row="1" Grid.Column="2" x:Name="DisconnectButton" Content="{local:Str Main_Disconnect}" Padding="12,2" Margin="0,0,0,6" Click="OnDisconnect" />

                        <TextBlock Grid.Row="2" Text="{local:Str Main_Video}" Margin="0,0,12,12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="VideoText" Margin="0,0,0,12" />

                        <TextBlock Grid.Row="3" Text="{local:Str Main_Touch}" Margin="0,0,12,12" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <CheckBox x:Name="TouchCheck" Click="OnTouchClick" />
                            <TextBlock x:Name="TouchNote" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </StackPanel>

                        <DockPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="{local:Str Main_Refresh}" Padding="12,2" Click="OnRefresh" />
                            <TextBlock Text="{local:Str Main_Source}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <ListBox Grid.Row="5" Grid.ColumnSpan="3" x:Name="MonitorList" SelectionChanged="OnSourceSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" Margin="0,0,8,0"
                                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{local:Str Main_AddDevice}" Padding="12,4" Click="OnAddDevice" x:Name="AddDeviceButton" />
                            <TextBlock x:Name="HintText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{local:Str Tab_Settings}">
                <local:SettingsView x:Name="SettingsPage" />
            </TabItem>
            <TabItem Header="{local:Str Tab_Diag}">
                <local:DiagnosticsView x:Name="DiagnosticsPage" />
            </TabItem>
            <TabItem Header="{local:Str Tab_Guide}">
                <local:GuideView x:Name="GuidePage" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
